<UCL>
  <CFG>
    <STATE name="BootStrap" dev="MX6UL" vid="15A2" pid="0080"/>
    <STATE name="Updater"   dev="MSC" vid="066F" pid="37FF"/>
  </CFG>

  <!-- ============================================================
       eMMC 整盘烧录：SOM-TLIMX6U-32GE4GD-I-A2.0
       4G eMMC + 512MB DDR3
       使用预生成的 sdcard.img 整盘 dd 到 /dev/mmcblk1
       ============================================================ -->
  <LIST name="SOM-TLIMX6U-32GE4GD-I-A2.0" desc="4G eMMC + 512MB DDR3 (整盘镜像)">
    <!-- BootStrap：加载临时系统到 DDR -->
    <CMD state="BootStrap" type="boot" body="BootStrap" file="firmware/u-boot_emmc.imx" ifdev="MX6UL">Loading U-boot</CMD>
    <CMD state="BootStrap" type="load" file="firmware/zImage_emmc" address="0x80800000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading Kernel.</CMD>
    <CMD state="BootStrap" type="load" file="firmware/%initramfs1%" address="0x83800000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading Initramfs.</CMD>
    <CMD state="BootStrap" type="load" file="firmware/imx6ul-14x14-evk_emmc.dtb" address="0x83000000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading device tree.</CMD>
    <CMD state="BootStrap" type="jump">Jumping to OS image.</CMD>

    <!-- Updater 1：写 U-Boot 到 eMMC boot0 硬件分区 -->
    <CMD state="Updater" type="push" body="$ echo 0 > /sys/block/mmcblk%mmc%boot0/force_ro">access boot partition 1</CMD>
    <CMD state="Updater" type="push" body="send" file="files/linux/u-boot.imx" ifdev="MX6UL">Sending u-boot.imx</CMD>
    <CMD state="Updater" type="push" body="$ dd if=$FILE of=/dev/mmcblk%mmc%boot0 bs=512 seek=2">write U-Boot to eMMC boot0</CMD>
    <CMD state="Updater" type="push" body="$ echo 1 > /sys/block/mmcblk%mmc%boot0/force_ro">re-enable read-only access</CMD>
    <CMD state="Updater" type="push" body="$ mmc bootpart enable 1 1 /dev/mmcblk%mmc%">enable boot partition 1</CMD>

    <!-- Updater 2：整盘写入 sdcard.img -->
    <CMD state="Updater" type="push" body="send" file="files/linux/sdcard.img">Sending full disk image</CMD>
    <CMD state="Updater" type="push" body="$ dd if=$FILE of=/dev/mmcblk%mmc% bs=1M conv=fsync">Writing full disk image</CMD>

    <CMD state="Updater" type="push" body="$ echo Update Complete!">Done</CMD>
  </LIST>

  <!-- ============================================================
       单独更新 Kernel / DTB
       只挂载 boot 分区，覆盖 zImage 和 dtb，不碰分区表和 rootfs
       ============================================================ -->
  <LIST name="Update-Kernel-DTB-Only" desc="仅更新 Kernel 和 DTB 到 boot 分区">
    <!-- BootStrap：与整盘烧录保持一致 -->
    <CMD state="BootStrap" type="boot" body="BootStrap" file="firmware/u-boot_emmc.imx" ifdev="MX6UL">Loading U-boot</CMD>
    <CMD state="BootStrap" type="load" file="firmware/zImage_emmc" address="0x80800000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading Kernel.</CMD>
    <CMD state="BootStrap" type="load" file="firmware/%initramfs1%" address="0x83800000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading Initramfs.</CMD>
    <CMD state="BootStrap" type="load" file="firmware/imx6ul-14x14-evk_emmc.dtb" address="0x83000000"
        loadSection="OTH" setSection="OTH" HasFlashHeader="FALSE" ifdev="MX6UL">Loading device tree.</CMD>
    <CMD state="BootStrap" type="jump">Jumping to OS image.</CMD>

    <!-- Updater：挂载 boot 分区，覆盖文件 -->
    <CMD state="Updater" type="push" body="$ mkdir -p /mnt/boot">Create mount point</CMD>
    <CMD state="Updater" type="push" body="$ mount -t vfat /dev/mmcblk%mmc%p1 /mnt/boot">Mount boot partition</CMD>

    <CMD state="Updater" type="push" body="send" file="files/linux/zImage">Sending new zImage</CMD>
    <CMD state="Updater" type="push" body="$ cp $FILE /mnt/boot/zImage">Update zImage</CMD>

    <CMD state="Updater" type="push" body="send" file="files/linux/my-imx6ull-emmc-iop.dtb">Sending new dtb</CMD>
    <CMD state="Updater" type="push" body="$ cp $FILE /mnt/boot/imx6ul-14x14-evk.dtb">Update dtb</CMD>

    <CMD state="Updater" type="push" body="$ sync">Sync filesystem</CMD>
    <CMD state="Updater" type="push" body="$ umount /mnt/boot">Unmount boot partition</CMD>
    <CMD state="Updater" type="push" body="$ echo Update Complete!">Done</CMD>
  </LIST>

</UCL>