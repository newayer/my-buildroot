auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
    address 192.168.10.1
    netmask 255.255.255.0

auto br-lan
iface br-lan inet static
    bridge_ports eth1
    address 192.168.1.1
    netmask 255.255.255.0
    pre-up ip link set eth1 up || true
    pre-up brctl addif br-lan eth1 || true
