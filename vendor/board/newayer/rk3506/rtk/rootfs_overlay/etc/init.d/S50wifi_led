#!/bin/sh
# /etc/init.d/S50wifi_led

case "$1" in
    start)
        echo "Configuring WiFi LED trigger..."
        echo netdev > /sys/class/leds/wifi_led/trigger
        echo wlan0 > /sys/class/leds/wifi_led/device_name
        echo 1 > /sys/class/leds/wifi_led/link
        ;;
    stop)
        echo 0 > /sys/class/leds/wifi_led/link
        echo none > /sys/class/leds/wifi_led/trigger
        ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
