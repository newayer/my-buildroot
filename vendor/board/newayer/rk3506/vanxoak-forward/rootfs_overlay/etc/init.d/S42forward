#!/bin/sh
#
#

REMOTE_ETH1=192.168.2.0
REMOTE_ETH0=192.168.91.25

start() {
    printf "Starting net forward: "
    ip route add $(REMOTE_ETH1)/24 via $(REMOTE_ETH0) dev eth0
    iptables -A FORWARD -i eth1 -o eth0 -j ACCEPT  # 从B到A的转发
    iptables -A FORWARD -i eth0 -o eth1 -j ACCEPT  # 从A到B的转发
    echo "OK"
}

stop() {
    printf "Stopping forward: "
    echo "OK"
}

restart() {
    stop
    sleep 3
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?

