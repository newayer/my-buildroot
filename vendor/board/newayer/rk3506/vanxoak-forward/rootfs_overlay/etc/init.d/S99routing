#!/bin/sh
#
#

REMOTE_ETH1=192.168.2.0
REMOTE_ETH0=192.168.91.25

start() {
    printf "Starting net forward: "

    ip route add ${REMOTE_ETH1}/24 via ${REMOTE_ETH0} dev eth0

    iptables -P FORWARD ACCEPT
    iptables -A FORWARD -i eth1 -o eth0 -j ACCEPT
    iptables -A FORWARD -i eth0 -o eth1 -j ACCEPT
    iptables -A FORWARD -s 192.168.1.0/24 -d 192.168.2.0/24 -j ACCEPT
    iptables -A FORWARD -s 192.168.2.0/24 -d 192.168.1.0/24 -j ACCEPT

    echo "OK"
}

stop() {
    printf "Stopping forward: "
    echo "OK"
}

restart() {
    stop
    sleep 3
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
