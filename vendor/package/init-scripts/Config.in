menuconfig BR2_PACKAGE_INIT_SCRIPTS
	bool "init scripts"
	help
	  Set of scripts used by system init.

if BR2_PACKAGE_INIT_SCRIPTS

config BR2_PACKAGE_INIT_SCRIPT_CAN
	bool "init scripts can"
	default n
	help
	  can interface up

config BR2_PACKAGE_INIT_SCRIPT_TIME
	bool "init scripts time"
	default n
	help
	  system time syc

config BR2_PACKAGE_INIT_SCRIPT_MOUNT
	bool "init scripts mount"
	default n
	help
	  opt partion mount

config BR2_PACKAGE_INIT_SCRIPT_DAEMON_WIFI
	bool "init scripts for wifi"
	default n
	help
	  init wifi up

config BR2_PACKAGE_INIT_SCRIPT_ADB
	bool "init scripts adb tools"
	default n
	help
	  adb device up

config BR2_PACKAGE_INIT_SCRIPT_NAT
	bool "init scripts net nat"
	default n
	help
	  net nat

config BR2_PACKAGE_INIT_SCRIPT_ETH
	bool "config the eth iface to static IP"
	default n
	depends on BR2_PACKAGE_BUSYBOX || BR2_PACKAGE_IFUPDOWN
	help
	  config the eth iface to static IP

if BR2_PACKAGE_INIT_SCRIPT_ETH

config BR2_PACKAGE_INIT_SCRIPT_ETH_NAME
	string "Network interface to configure with static IP"
	default "eth0"
	help
	  Enter here the name of the network interface (E.G. eth0) to
	  configure with static IP at bootup.

config BR2_PACKAGE_INIT_SCRIPT_ETH_IP
	string "configured IP for Network interface"
	default "192.168.11.7"
	help
	  Enter here the IP of the network interface (E.G. eth0) to
	  configure at bootup.

endif

config BR2_PACKAGE_INIT_SCRIPT_ETH2
	bool "config the eth2 iface to static IP"
	default n
	depends on BR2_PACKAGE_BUSYBOX || BR2_PACKAGE_IFUPDOWN
	help
	  config the eth iface to static IP

if BR2_PACKAGE_INIT_SCRIPT_ETH2

config BR2_PACKAGE_INIT_SCRIPT_ETH2_NAME
	string "Network interface to configure with static IP"
	default "eth1"
	help
	  Enter here the name of the network interface (E.G. eth1) to
	  configure with static IP at bootup.

config BR2_PACKAGE_INIT_SCRIPT_ETH2_IP
	string "configured IP for Network interface"
	default "192.168.22.7"
	help
	  Enter here the IP of the network interface (E.G. eth1) to
	  configure at bootup.

endif

endif
